# Copy this file to .env (git-ignored) and replace every CHANGE_ME value.
# CHANGE_ME is a placeholder, not a working value.

# JWT_SECRET: base64 of at least 32 random bytes, shared by ALL services that validate JWTs.
# Generate one with:  openssl rand -base64 32
#   or PowerShell:  [Convert]::ToBase64String((1..32 | % { Get-Random -Maximum 256 }))
# Services refuse to start until the placeholder is replaced with a valid key.
JWT_SECRET=CHANGE_ME

# Required by docker-compose.production.yml and docker-compose.performance.yml only.
# DB_PASSWORD: PostgreSQL password used by the database container and every service.
DB_PASSWORD=CHANGE_ME
# GRAFANA_PASSWORD: Grafana admin password.
GRAFANA_PASSWORD=CHANGE_ME
