# Copy this file to .env (git-ignored) and replace every CHANGE_ME value.
# CHANGE_ME is a placeholder, not a working value.

# JWT_SECRET: base64 of at least 32 random bytes, shared by ALL services that validate JWTs.
# Generate one with:  openssl rand -base64 32
#   or PowerShell:  $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# Services refuse to start until the placeholder is replaced with a valid key.
JWT_SECRET=CHANGE_ME

# DB_PASSWORD: PostgreSQL password used by the database container and every service.
# Required by docker-compose.production.yml, docker-compose.performance.yml and the public mode
# (docker-compose.public.yml). Optional in development: without it the password is "postgres".
# The database keeps the password it was created with: scripts\init-public-env.ps1 generates this
# value and changes the role's password to it (ALTER ROLE). Never change it here by hand alone,
# the services would no longer get in.
#DB_PASSWORD=CHANGE_ME

# REDIS_PASSWORD: password of Redis in the public mode (generated by scripts\init-public-env.ps1).
# The development stack runs Redis without a password and ignores it.
#REDIS_PASSWORD=CHANGE_ME
# GRAFANA_PASSWORD: Grafana admin password.
GRAFANA_PASSWORD=CHANGE_ME

# MEDIA_ORPHAN_RETENTION_DAYS (optional, default 14): confirmed media files that no exam uses
# (drafts count as use) are deleted after this many days. 0 or a negative number switches that off.
# MEDIA_ORPHAN_RETENTION_DAYS=14

# EXAM_DAY_ZONE (optional, default Asia/Baku): the time zone whose midnight starts a new day for the
# daily attempt limit of an exam (maxAttemptsPerDay). Dates in the database and the API stay UTC.
# EXAM_DAY_ZONE=Asia/Baku

# GROUP_JOIN_REJECT_COOLDOWN_HOURS (optional, default 24): after a rejected join request the same user
# may ask that group again only this many hours later. 0 = at once.
# GROUP_JOIN_REJECT_COOLDOWN_HOURS=24

# REQUIRE_CHANGE_REASON_AFTER_PUBLISH (optional, default false): with true, a sensitive change (answer key,
# points, duration, time window, block timers and rules, publish, archive) of a SCHEDULED or ACTIVE exam
# needs changeReason (3-500 characters), otherwise 400 CHANGE_REASON_REQUIRED. The reason is always kept
# in the exam's history when given.
# REQUIRE_CHANGE_REASON_AFTER_PUBLISH=false

# EXAM_BLOCK_RULES_ENABLED (optional, default false): leave false until B12b (the participant side of
# blocks) is deployed; until then exams with block timers, fixed navigation or returning to earlier
# blocks cannot be published (409 FEATURE_NOT_AVAILABLE).
# EXAM_BLOCK_RULES_ENABLED=false

# EXAM_FRAUD_RISK_MEDIUM / _HIGH / _CRITICAL (optional, defaults 5 / 15 / 30): from which weighted sum
# of a session's fraud events its risk level is MEDIUM, HIGH and CRITICAL. They must ascend.
# EXAM_FRAUD_RISK_MEDIUM=5
# EXAM_FRAUD_RISK_HIGH=15
# EXAM_FRAUD_RISK_CRITICAL=30

# OTP_HMAC_SECRET: base64 of at least 32 random bytes, auth-service only. Email verification codes are
# stored only as an HMAC under this key. Generate it like JWT_SECRET, but use a DIFFERENT value.
# Generate one with:  openssl rand -base64 32
#   or PowerShell:  $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# auth-service refuses to start until the placeholder is replaced with a valid key.
# Check the whole file before starting the stack:  .\scripts\check-env.ps1
OTP_HMAC_SECRET=CHANGE_ME

# MAIL_*: SMTP server for outgoing email (verification and password reset codes). Any provider with
# SMTP works; there is no provider-specific API.
#
# Development (docker-compose.yml): leave the whole block commented out. Every email then goes to the
# local Mailpit (http://localhost:8025) and nothing is delivered. To send through a real provider from
# the development stack, uncomment the block and fill it in; to go back to Mailpit, comment it out
# again and run "docker-compose up -d auth-service".
# Production (docker-compose.production.yml): MAIL_HOST and MAIL_FROM are required.
#
#   MAIL_HOST                     : SMTP host of the provider
#   MAIL_PORT + transport switch  : 587 with MAIL_STARTTLS=true and MAIL_SSL=false (the usual choice), or
#                                   465 with MAIL_SSL=true and MAIL_STARTTLS=false (TLS from the first byte).
#                                   Never both true. Set all three with MAIL_HOST: the development
#                                   defaults (port 1025, no TLS, no login) fit Mailpit only.
#   MAIL_SMTP_AUTH                : true = log in with MAIL_USERNAME / MAIL_PASSWORD (every real provider)
#   MAIL_USERNAME / MAIL_PASSWORD : SMTP credentials (often an API key or app password, not the
#                                   account password)
#   MAIL_FROM                     : sender address, e.g. no-reply@your-domain. Required with a real host:
#                                   auth-service refuses to start without it. The domain needs SPF/DKIM.
#   MAIL_FROM_NAME                : optional display name of the sender (default "Exam System")
#   MAIL_REPLY_TO                 : optional address that answers go to (e.g. support@your-domain)
#MAIL_HOST=CHANGE_ME
#MAIL_PORT=587
#MAIL_SMTP_AUTH=true
#MAIL_STARTTLS=true
#MAIL_SSL=false
#MAIL_USERNAME=CHANGE_ME
#MAIL_PASSWORD=CHANGE_ME
#MAIL_FROM=CHANGE_ME
#MAIL_FROM_NAME=Exam System
#MAIL_REPLY_TO=CHANGE_ME

# PUBLIC_MAIL_*: the SMTP server of the temporary public mode (docker-compose.public.yml,
# docs/PUBLIC_TEMP.md). Required there: scripts\go-public.ps1 start refuses to start without them.
# Same meaning as MAIL_* above (auth-service gets them as MAIL_*), but a separate name, so the
# development stack keeps using Mailpit and its test registrations never send a real email.
#
# Gmail (a personal account, about 500 emails a day):
#   1. Turn on 2-Step Verification for the Google account.
#   2. Create an App Password at https://myaccount.google.com/apppasswords (16 letters). The account
#      password itself does NOT work for SMTP and must never be written here.
#   3. PUBLIC_MAIL_USERNAME and PUBLIC_MAIL_FROM are the Gmail address; Gmail sends only as that
#      address (or an alias verified in Gmail).
#   Port 587 with STARTTLS (below) or 465 with PUBLIC_MAIL_SSL=true and PUBLIC_MAIL_STARTTLS=false.
#PUBLIC_MAIL_HOST=smtp.gmail.com
#PUBLIC_MAIL_PORT=587
#PUBLIC_MAIL_SMTP_AUTH=true
#PUBLIC_MAIL_STARTTLS=true
#PUBLIC_MAIL_SSL=false
#PUBLIC_MAIL_USERNAME=CHANGE_ME@gmail.com
#PUBLIC_MAIL_PASSWORD=CHANGE_ME
#PUBLIC_MAIL_FROM=CHANGE_ME@gmail.com
#PUBLIC_MAIL_FROM_NAME=Yukselis Imtahan
#PUBLIC_MAIL_REPLY_TO=

# INTERNAL_SERVICE_SECRET: at least 32 random characters, shared by auth-service and exam-service only.
# It protects their service-to-service endpoints (/internal/**), which the gateway does not route.
# Generate it like JWT_SECRET. Left as CHANGE_ME, removed or
# shorter than 32 characters, those endpoints are switched off: user groups cannot resolve emails
# (adding a member by email or id and the CSV import answer 503) and pending invites are not applied.
INTERNAL_SERVICE_SECRET=CHANGE_ME

# Optional, auth-service only: the first ADMIN is created on startup when BOTH are set and no ADMIN
# exists yet. Left as CHANGE_ME (or removed) nothing is created. Self-registration only creates students.
ADMIN_EMAIL=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME

# MEDIA_S3_ACCESS_KEY / MEDIA_S3_SECRET_KEY: credentials of the object storage that holds question media
# (SeaweedFS in docker-compose.yml; they are its root identity there). Required, no default: the
# development stack refuses to start without them. Use letters and digits only, e.g. 20 and 40 random
# characters (PowerShell: -join ((48..57 + 65..90 + 97..122) | Get-Random -Count 40 | % { [char]$_ })).
MEDIA_S3_ACCESS_KEY=CHANGE_ME
MEDIA_S3_SECRET_KEY=CHANGE_ME
# Optional in development, required by docker-compose.production.yml (REDIS_PASSWORD as well).
# MEDIA_S3_PUBLIC_ENDPOINT: the storage address as the BROWSER reaches it; it is the host
# inside every presigned upload/download URL (default http://localhost:8333).
# MEDIA_CORS_ORIGINS: frontend origins allowed to upload/download directly at the storage, comma
# separated (default http://localhost:3000,http://localhost:5173).
#MEDIA_S3_PUBLIC_ENDPOINT=http://localhost:8333
#MEDIA_CORS_ORIGINS=http://localhost:3000
# --- Gateway (optional in development; production compose requires CORS_ALLOWED_ORIGINS and GATEWAY_TRUSTED_PROXIES)
# CORS_ALLOWED_ORIGINS: sites allowed to call the API, comma separated (development: any localhost port).
# GATEWAY_TRUSTED_PROXIES: IPs/CIDRs of proxies (nginx) whose X-Forwarded-For the rate limiter believes;
# empty = the remote address of the connection. Never list addresses clients can reach directly.
# GATEWAY_AUTH_*: per-address capacity of /auth/register and /auth/login (requests per second and burst).
#CORS_ALLOWED_ORIGINS=http://localhost:3000
#GATEWAY_TRUSTED_PROXIES=
#GATEWAY_AUTH_REGISTER_RATE=100
#GATEWAY_AUTH_REGISTER_BURST=200
#GATEWAY_AUTH_LOGIN_RATE=100
#GATEWAY_AUTH_LOGIN_BURST=200
# GATEWAY_OTP_REPLENISH / GATEWAY_OTP_BURST: per-address budget of /auth/verify-otp, resend-otp,
# forgot-password and reset-password. Every request takes 5 tokens: the defaults 1 and 50 allow 10
# requests at once, then one every 5 seconds. Keep them strict; raise them only when many people
# verify through one address (a school network), e.g. GATEWAY_OTP_BURST=250 for 50 at once. The limits
# per email address (auth-service) stay as they are.
#GATEWAY_OTP_REPLENISH=1
#GATEWAY_OTP_BURST=50
# The public mode (docker-compose.public.yml) sets CORS_ALLOWED_ORIGINS and GATEWAY_TRUSTED_PROXIES
# itself and uses the production defaults 500 / 1000 for GATEWAY_AUTH_*.
