# Copy this file to .env (git-ignored) and replace every CHANGE_ME value.
# CHANGE_ME is a placeholder, not a working value.

# JWT_SECRET: base64 of at least 32 random bytes, shared by ALL services that validate JWTs.
# Generate one with:  openssl rand -base64 32
#   or PowerShell:  [Convert]::ToBase64String((1..32 | % { Get-Random -Maximum 256 }))
# Services refuse to start until the placeholder is replaced with a valid key.
JWT_SECRET=CHANGE_ME

# Required by docker-compose.production.yml and docker-compose.performance.yml only.
# DB_PASSWORD: PostgreSQL password used by the database container and every service.
DB_PASSWORD=CHANGE_ME
# GRAFANA_PASSWORD: Grafana admin password.
GRAFANA_PASSWORD=CHANGE_ME

# OTP_HMAC_SECRET: base64 of at least 32 random bytes, auth-service only. Email verification codes are
# stored only as an HMAC under this key. Generate it like JWT_SECRET, but use a DIFFERENT value.
# auth-service refuses to start until the placeholder is replaced with a valid key.
OTP_HMAC_SECRET=CHANGE_ME

# MAIL_*: SMTP server for outgoing email (verification and password reset codes). Any provider with
# SMTP works; there is no provider-specific API.
#
# Development (docker-compose.yml): leave the whole block commented out. Every email then goes to the
# local Mailpit (http://localhost:8025) and nothing is delivered. To send through a real provider from
# the development stack, uncomment the block and fill it in; to go back to Mailpit, comment it out
# again and run "docker-compose up -d auth-service".
# Production (docker-compose.production.yml): MAIL_HOST and MAIL_FROM are required.
#
#   MAIL_HOST                     : SMTP host of the provider
#   MAIL_PORT + transport switch  : 587 with MAIL_STARTTLS=true and MAIL_SSL=false (the usual choice), or
#                                   465 with MAIL_SSL=true and MAIL_STARTTLS=false (TLS from the first byte).
#                                   Never both true. Set all three with MAIL_HOST: the development
#                                   defaults (port 1025, no TLS, no login) fit Mailpit only.
#   MAIL_SMTP_AUTH                : true = log in with MAIL_USERNAME / MAIL_PASSWORD (every real provider)
#   MAIL_USERNAME / MAIL_PASSWORD : SMTP credentials (often an API key or app password, not the
#                                   account password)
#   MAIL_FROM                     : sender address, e.g. no-reply@your-domain. Required with a real host:
#                                   auth-service refuses to start without it. The domain needs SPF/DKIM.
#   MAIL_FROM_NAME                : optional display name of the sender (default "Exam System")
#   MAIL_REPLY_TO                 : optional address that answers go to (e.g. support@your-domain)
#MAIL_HOST=CHANGE_ME
#MAIL_PORT=587
#MAIL_SMTP_AUTH=true
#MAIL_STARTTLS=true
#MAIL_SSL=false
#MAIL_USERNAME=CHANGE_ME
#MAIL_PASSWORD=CHANGE_ME
#MAIL_FROM=CHANGE_ME
#MAIL_FROM_NAME=Exam System
#MAIL_REPLY_TO=CHANGE_ME

# INTERNAL_SERVICE_SECRET: at least 32 random characters, shared by auth-service and exam-service only.
# It protects their service-to-service endpoints (/internal/**), which the gateway does not route.
# Generate it like JWT_SECRET. Left as CHANGE_ME, removed or
# shorter than 32 characters, those endpoints are switched off: user groups cannot resolve emails
# (adding a member by email or id and the CSV import answer 503) and pending invites are not applied.
INTERNAL_SERVICE_SECRET=CHANGE_ME

# Optional, auth-service only: the first ADMIN is created on startup when BOTH are set and no ADMIN
# exists yet. Left as CHANGE_ME (or removed) nothing is created. Self-registration only creates students.
ADMIN_EMAIL=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME

# MEDIA_S3_ACCESS_KEY / MEDIA_S3_SECRET_KEY: credentials of the object storage that holds question media
# (SeaweedFS in docker-compose.yml; they are its root identity there). Required, no default: the
# development stack refuses to start without them. Use letters and digits only, e.g. 20 and 40 random
# characters (PowerShell: -join ((48..57 + 65..90 + 97..122) | Get-Random -Count 40 | % { [char]$_ })).
MEDIA_S3_ACCESS_KEY=CHANGE_ME
MEDIA_S3_SECRET_KEY=CHANGE_ME
# Optional. MEDIA_S3_PUBLIC_ENDPOINT: the storage address as the BROWSER reaches it; it is the host
# inside every presigned upload/download URL (default http://localhost:8333).
# MEDIA_CORS_ORIGINS: frontend origins allowed to upload/download directly at the storage, comma
# separated (default http://localhost:3000,http://localhost:5173).
#MEDIA_S3_PUBLIC_ENDPOINT=http://localhost:8333
#MEDIA_CORS_ORIGINS=http://localhost:3000
